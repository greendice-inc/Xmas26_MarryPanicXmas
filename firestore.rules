rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 会場の端末から、ログインなしで読み書きする
    match /teams/{id} {
      allow read, write: if true;
    }
    match /presence/{id} {
      allow read, write: if true;
    }
    // 商品登録サイトとゲームが共有する商品
    match /items/{id} {
      allow read, write: if true;
    }
    // ゲームの設定（ステージ2のタップエリアなど）
    match /config/{id} {
      allow read, write: if true;
    }
    // セリフ編集（キャラの立ち絵・場面のセリフ・効果音と音声）
    match /script/{id} {
      allow read, write: if true;
    }
  }
}
